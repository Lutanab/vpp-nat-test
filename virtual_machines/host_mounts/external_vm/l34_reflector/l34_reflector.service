[Unit]
Description=L34 Reflector HTTP Service (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__REFLECTOR_DIR__
ExecStart=/usr/bin/python3 __REFLECTOR_DIR__/reflector_server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
