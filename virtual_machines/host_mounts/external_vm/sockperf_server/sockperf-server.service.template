[Unit]
Description=Sockperf NAT benchmark server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
ExecStart=__SOCKPERF_BIN__ server -i ${SOCKPERF_BIND} -p ${SOCKPERF_PORT} --msg-size ${SOCKPERF_MSG_SIZE} $SOCKPERF_GAP_DETECTION $SOCKPERF_EXTRA_ARGS
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
