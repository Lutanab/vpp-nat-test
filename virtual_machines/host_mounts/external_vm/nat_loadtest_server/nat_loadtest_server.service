[Unit]
Description=NAT Loadtest L34 UDP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__SERVER_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__UV_BIN__ run nat-loadtest-server serve l34-udp --bind ${L34_UDP_BIND} --port ${L34_UDP_PORT} --mode ${L34_UDP_MODE}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
